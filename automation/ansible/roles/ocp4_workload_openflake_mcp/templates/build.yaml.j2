---
apiVersion: image.openshift.io/v1
kind: ImageStream
metadata:
  name: "{{ ocp4_workload_openflake_mcp_app_name }}"
  labels:
    app: "{{ ocp4_workload_openflake_mcp_app_name }}"
spec:
  lookupPolicy:
    local: true

---
# Binary source: the Ansible role uploads Containerfile + start.py from
# files/app/ directly — no external git repository required.
apiVersion: build.openshift.io/v1
kind: BuildConfig
metadata:
  name: "{{ ocp4_workload_openflake_mcp_app_name }}"
  labels:
    app: "{{ ocp4_workload_openflake_mcp_app_name }}"
spec:
  source:
    type: Binary
  strategy:
    type: Docker
    dockerStrategy:
      dockerfilePath: Containerfile
  output:
    to:
      kind: ImageStreamTag
      name: "{{ ocp4_workload_openflake_mcp_app_name }}:latest"
  resources:
    limits:
      memory: 2Gi
