---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{ ocp4_workload_openflake_mcp_app_name }}"
  namespace: "{{ ocp4_workload_openflake_mcp_namespace }}"
  labels:
    app: "{{ ocp4_workload_openflake_mcp_app_name }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: "{{ ocp4_workload_openflake_mcp_app_name }}"
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: "{{ ocp4_workload_openflake_mcp_app_name }}"
    spec:
      containers:
        - name: "{{ ocp4_workload_openflake_mcp_app_name }}"
          image: "{{ _effective_image }}"
          imagePullPolicy: Always
          ports:
            - name: app
              containerPort: 8000
          envFrom:
            - secretRef:
                name: "{{ ocp4_workload_openflake_mcp_app_name }}-env"
          readinessProbe:
            tcpSocket:
              port: 8000
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 8000
            initialDelaySeconds: 30
            periodSeconds: 20
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              memory: 1Gi
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
            seccompProfile:
              type: RuntimeDefault

        - name: nginx
          image: docker.io/nginxinc/nginx-unprivileged:alpine
          ports:
            - name: http
              containerPort: 8080
          volumeMounts:
            - name: nginx-conf
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
              readOnly: true
            - name: nginx-cache
              mountPath: /var/cache/nginx
            - name: nginx-run
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 20
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
            seccompProfile:
              type: RuntimeDefault

      volumes:
        - name: nginx-conf
          secret:
            secretName: "{{ ocp4_workload_openflake_mcp_app_name }}-nginx-conf"
            defaultMode: 0440
        - name: nginx-cache
          emptyDir: {}
        - name: nginx-run
          emptyDir: {}

---
apiVersion: v1
kind: Service
metadata:
  name: "{{ ocp4_workload_openflake_mcp_app_name }}"
  namespace: "{{ ocp4_workload_openflake_mcp_namespace }}"
  labels:
    app: "{{ ocp4_workload_openflake_mcp_app_name }}"
spec:
  type: ClusterIP
  selector:
    app: "{{ ocp4_workload_openflake_mcp_app_name }}"
  ports:
    - name: http
      port: 8080
      targetPort: 8080

---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: "{{ ocp4_workload_openflake_mcp_app_name }}"
  namespace: "{{ ocp4_workload_openflake_mcp_namespace }}"
  labels:
    app: "{{ ocp4_workload_openflake_mcp_app_name }}"
  annotations:
    haproxy.router.openshift.io/timeout: 1h
spec:
  to:
    kind: Service
    name: "{{ ocp4_workload_openflake_mcp_app_name }}"
    weight: 100
  port:
    targetPort: http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
