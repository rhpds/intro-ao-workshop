{
  "schema_version": "2.0.0",
  "name": "Message of the Day",
  "description": "Ask an AI agent to turn a scribbled maintenance note into a login banner, then have an AAP job template write it onto the RHEL nodes alongside their own live facts. The reference copy of the workflow the student builds by hand in module 03.",
  "triggers": [
    {
      "id": "trigger_manual",
      "type": "manual_trigger",
      "name": "Trigger",
      "parameters": {
        "input_schema": {
          "type": "object",
          "required": [
            "banner_request"
          ],
          "properties": {
            "banner_request": {
              "type": "string"
            }
          }
        }
      },
      "position": {
        "x": 0,
        "y": 300
      }
    }
  ],
  "nodes": [
    {
      "id": "motd_agent",
      "type": "agentic",
      "name": "Task Agent",
      "parameters": {
        "prompt": "You are a RHEL systems administrator writing the login banner for a\nserver. An engineer has given you this note:\n\n${trigger.banner_request}\n\nWrite the banner. Give a short headline in capitals, a notice of two\nor three sentences telling anyone who logs in what to expect and when,\nand the name of the team to contact.\n\nDo not invent facts about the host. The banner already shows its real\nconfiguration, gathered from the host itself.",
        "response_schema": {
          "type": "object",
          "required": [
            "headline",
            "notice",
            "owner"
          ],
          "properties": {
            "headline": {
              "type": "string"
            },
            "notice": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          }
        },
        "tool_selections": [],
        "integration_connections": [],
        "tool_selection_strategy": "NONE"
      },
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "set_motd",
      "type": "aap_job_template",
      "name": "Launch AAP job template",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "motd_headline": "${motd_agent.result.content.headline}",
          "motd_notice": "${motd_agent.result.content.notice}",
          "motd_owner": "${motd_agent.result.content.owner}"
        },
        "job_template_name": "Linux - Set Message of the Day",
        "organization_name": "Default"
      },
      "position": {
        "x": 800,
        "y": 300
      }
    }
  ],
  "edges": [
    {
      "from": "trigger_manual",
      "to": "motd_agent"
    },
    {
      "from": "motd_agent",
      "to": "set_motd"
    }
  ]
}
